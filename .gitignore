# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.cache/

# Virtual environments
.venv
venv

# Environment config
.env
!.env.example

# Runtime data — generated during crawls / translations / packaging
*.log

# Per-novel artefacts
translated/
!translated/.gitkeep

# Global runtime state
runtime/
!runtime/.gitkeep

# Local-only configs
configs/*
!configs/*.json

# OS
.DS_Store
Thumbs.db

# Web frontend build output
web/dist/
web/node_modules/

# Generated config drafts (created by the API server)
runtime/config-drafts/

# Coverage artifacts
.coverage
htmlcov/

# Outside scripts
scripts/
