# --- Output directory ---
TRANSLATED_DIR=translated

# --- LLM provider ---
LLM_PROVIDER=ollama
FALLBACK_PROVIDER=gemini

# --- Crawler settings ---
MAX_CHAPTERS=0
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096

# --- Provider endpoints ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:14b

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-14b

# --- Translator settings ---
# TARGET_LANGUAGE: vi: Vietnamese, en: English
TARGET_LANGUAGE=vi
TRANSLATION_TEMPERATURE=0.3
TRANSLATION_MAX_TOKENS=4096
CHUNK_MODE=chars
CHUNK_SIZE=1500
CHUNK_OVERLAP=100
REVIEW_THRESHOLD=0.7
MAX_RETRIES=2
ENABLE_REVIEW=false
ENABLE_SUMMARY=false

# --- Telegram notifications ---
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_PARSE_MODE=HTML
TELEGRAM_SILENT=false
TELEGRAM_TIMEOUT_SECONDS=10.0

# --- Web GUI / API server ---
# Bind address. Loopback (default) skips authentication. Non-loopback values
# (e.g. 0.0.0.0, a LAN IP, or a public host) force remote mode and require
# API_SECRET_KEY to be set or the server refuses to start.
API_HOST=127.0.0.1
API_PORT=8000
API_LOG_LEVEL=info
# Required when API_HOST is not loopback. Any non-empty random string works.
# API_SECRET_KEY=
# Comma-separated exact origins allowed by CORS. Required in remote mode;
# wildcards are rejected. Leave the default for local Vite dev only.
CORS_ORIGINS=http://localhost:5173
