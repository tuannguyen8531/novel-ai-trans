# --- APPLICATION SETTINGS ---
# These values seed runtime/settings.json when that file does not exist.
# After the first start, normal application settings are read from
# runtime/settings.json; API keys and deployment variables remain in .env.
TRANSLATED_DIR=translated
LOG_RETENTION_DAYS=30

LLM_PROVIDER=ollama
FALLBACK_PROVIDER=
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_MODEL=qwen/qwen3-8b

TARGET_LANGUAGE=vi
TRANSLATION_TEMPERATURE=0.3
TRANSLATION_MAX_TOKENS=8192
CHUNK_MODE=chars
CHUNK_SIZE=5000
CHUNK_OVERLAP=100
REVIEW_THRESHOLD=0.7
MAX_RETRIES=2

TELEGRAM_ENABLED=false
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_PARSE_MODE=HTML
TELEGRAM_SILENT=false
TELEGRAM_TIMEOUT_SECONDS=10.0

# --- LLM PROVIDER API KEYS ---
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# --- Telegram notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Web GUI / API server ---
# Bind address. Loopback (default) skips authentication. Non-loopback values
# (e.g. 0.0.0.0, a LAN IP, or a public host) force remote mode and require
# API_SECRET_KEY to be set or the server refuses to start.
API_HOST=127.0.0.1
API_PORT=8000
API_LOG_LEVEL=info
# Required when API_HOST is not loopback. Any non-empty random string works.
# API_SECRET_KEY=
# Comma-separated exact origins allowed by CORS. Required in remote mode;
# wildcards are rejected. Leave the default for local Vite dev only.
CORS_ORIGINS=http://localhost:5173
